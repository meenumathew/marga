# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies installed by npm; regenerate with `npm install`
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local editor settings
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. This is where a site's own settings live, so they are never tracked
# and an update from the base template can never overwrite them.
.env*
# The documented list of settings is part of the template, so it is tracked.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# per-user learning progress: runtime state, not part of the template.
# The app recreates it on first write, so a clone starts clean.
/content/.marga/

{
  "name": "marga",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "docs:lint": "vale README.md docs content/learn",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cli": "npm --prefix marga-cli test",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run format:check && npm run lint && npm run docs:lint && npm run typecheck && npm test && npm run test:cli && npm run security:audit && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.23.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.8.4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}

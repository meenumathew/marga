# Marga settings. Copy this file to .env.local and edit the values you care about.
#
#   cp .env.example .env.local
#
# Git ignores .env.local, so updating the base template never overwrites your
# settings, and updating never asks you to merge anything. Leave a setting out
# and the template's default is used. Restart the dev server after a change.
#
# `marga new` writes this file for you from the answers you give it, so a new
# site usually starts with one already.
#
# Full documentation: docs/how-to/configure-your-site.md

# The site name, shown in the page title and read out with the logo.
NEXT_PUBLIC_MARGA_SITE_NAME="MARGA"

# One sentence describing the site, used as the page description.
NEXT_PUBLIC_MARGA_SITE_DESCRIPTION="A customizable learning dashboard for courses, roadmaps, notes, and progress."

# Prefix for this site's browser storage keys. Keep it unique per site, and do
# not change it later: the dashboard reads existing progress under the old
# prefix and would look empty under a new one.
NEXT_PUBLIC_MARGA_STORAGE_PREFIX="marga"

# Accessible label for the logo. Defaults to the site name.
# NEXT_PUBLIC_MARGA_LOGO_LABEL="MARGA"

# Starting values for the dashboard greeting. Editing the dashboard's own
# customizer form overrides these in that browser.
# NEXT_PUBLIC_MARGA_DISPLAY_NAME="Learner"
# NEXT_PUBLIC_MARGA_FOCUS_AREA="Your craft"
# NEXT_PUBLIC_MARGA_WEEKLY_TARGET="5h this week"
# NEXT_PUBLIC_MARGA_HERO_MESSAGE="Stay consistent. Keep learning."

# Brand colours, as a JSON object of CSS custom properties per theme. Anything
# that is not a custom property name and a plain value is dropped with a warning.
# NEXT_PUBLIC_MARGA_THEME_LIGHT={"--gold":"#0f7f95"}
# NEXT_PUBLIC_MARGA_THEME_DARK={"--gold-2":"#22d3ee"}

# The origin that serves the site, so page metadata can build absolute URLs.
# Leave it unset for local use and those URLs stay relative.
# NEXT_PUBLIC_SITE_URL="https://notes.example.com"

# Where your notes and progress live. Defaults to this folder, which means notes
# sit inside the site. Point it at your own notes folder to keep them separate,
# which is what makes updating the template a change to code only.
# MARGA_STORAGE_ROOT="/Users/you/Documents/notes"
